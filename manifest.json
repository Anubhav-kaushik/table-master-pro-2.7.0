{
  "manifest_version": 3,
  "name": "Table Master Pro — Steroids Edition",
  "version": "3.0.0",
  "description": "Auto-detects any HTML table, opens a Google-Sheets-style live editor with formulas, datatype detection, row/column insertion, session reset, clipboard export, and flexible cross-table column merging.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Table Master Pro",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/detector.js", "src/formulas.js", "src/editor.js", "src/merger.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "table-master-pro@example.org",
      "strict_min_version": "121.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["src/styles.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
